{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/test0",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "***REMOVED***"
      },
      "models": {
        "test0": {
          "name": "test0",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permission": "allow",
  "lsp": true,
  "plugin": [
    "./plugins/agentmemory-capture.ts"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/test0"
    }
  }
}
