{
  // ---- 儲存路徑 ----
  "storagePath": "~/.opencode-mem/data",

  // ---- 本地 embedding（預設 HuggingFace 本地模型）- 不需要 API key ----
  // 如果你覺得首次下載太慢，可以改為 OpenAI 相容的 embedding API：
  // "embeddingApiUrl": "http://127.0.0.1:20128/v1",
  // "embeddingApiKey": "***REMOVED***",
  // "embeddingModel": "text-embedding-3-small",

  // ---- 記憶範圍 ----
  "memory": {
    "defaultScope": "project"
  },

  // ---- Web UI ----
  "webServerEnabled": true,
  "webServerPort": 4747,

  // ---- Auto-capture 關閉（只用手動記憶） ----
  "autoCaptureEnabled": false,

  // ---- 壓縮 ----
  "compaction": {
    "enabled": true,
    "memoryLimit": 10
  },

  // ---- 記憶注入 ----
  "chatMessage": {
    "enabled": true,
    "maxMemories": 3,
    "excludeCurrentSession": true,
    "injectOn": "first"
  }
}
