{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/test0",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "***REMOVED***"
      },
      "models": {
        "test0": {
          "name": "test0",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "mcp": {},
  "permission": "allow",
  "lsp": true,
  "plugin": [
    "./plugins/agentmemory-capture.ts",
    "oh-my-opencode-slim"
  ]
}
